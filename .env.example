# ===== Variables PÚBLICAS (visibles en el navegador, empiezan con VITE_) =====
# Número de WhatsApp con código de país, solo dígitos. Ej: 5215512345678
VITE_WHATSAPP_PHONE=
# Enlaces de los botones flotantes (si dejas uno vacío, ese botón no aparece)
VITE_WHATSAPP_URL=
VITE_FACEBOOK_URL=

# ===== Variables SECRETAS (solo servidor; NUNCA con prefijo VITE_) =====
# Clave de DeepSeek para el chatbot. En Vercel: Project Settings > Environment Variables.
DEEPSEEK_API_KEY=
